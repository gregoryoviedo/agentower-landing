---
interface Props {
  code: string;
  label?: string;
  showCopy?: boolean;
  class?: string;
}

const { code, label = 'terminal', showCopy = true, class: className = '' } = Astro.props;
---

<div class:list={['code-block', className]}>
  {
    (label || showCopy) && (
      <div class="flex items-center justify-between gap-4 border-b border-ink-700/60 px-4 py-2">
        <span class="font-mono text-[0.68rem] uppercase tracking-wider text-ink-500">{label}</span>
        {showCopy && (
          <button
            type="button"
            data-copy
            class="copy-btn inline-flex items-center gap-1.5 rounded-md border border-ink-700/70 bg-ink-850 px-2 py-1 font-mono text-[0.68rem] text-ink-400 transition-colors hover:border-brand-500/40 hover:text-brand-400"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="8" y="8" width="12" height="12" rx="2"></rect>
              <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
            </svg>
            <span data-copy-label>Copiar</span>
          </button>
        )}
      </div>
    )
  }
  <pre class="px-4 py-3.5"><code>{code}</code></pre>
</div>
