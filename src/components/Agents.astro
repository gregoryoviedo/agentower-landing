---
import SectionHeading from './SectionHeading.astro';
import { AGENTS, BASE } from '../data/site';

const base = BASE;
---

<section id="agentes" class="relative py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading
      title="Un bot, todos tus agentes"
      description="Agentower detecta los CLIs instalados en tu PATH (y en los bundles de app) y sigue sus sesiones sin que tengas que elegir nada. Podés cambiar de agente por chat cuando quieras."
    />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {AGENTS.map((agent) => (
        <li class="card card-hover p-6">
          <div class="flex items-center gap-3.5">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-ink-800 p-2.5">
              <img
                src={`${base}agents/${agent.logo}`}
                alt={`Logo de ${agent.name}`}
                width="28"
                height="28"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain"
              />
            </span>
            <div>
              <h3 class="text-[0.98rem] font-semibold">{agent.name}</h3>
              <span class="font-mono text-[0.72rem] uppercase tracking-wider text-ink-400">{agent.transport}</span>
            </div>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-ink-300">{agent.note}</p>
          <p class="mt-4 truncate border-t border-ink-700/50 pt-3 font-mono text-[0.75rem] text-ink-400">
            $ {agent.cli}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
