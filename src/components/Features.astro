---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { FEATURES } from '../data/site';
---

<section id="caracteristicas" class="relative py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading
      title="Pensado para dejar la máquina trabajando"
      description="Ejecutá, monitoreá y guiá sesiones de tus agentes desde el teléfono mientras tu máquina hace el trabajo real."
    />

    <ul class="mx-auto mt-14 grid max-w-5xl gap-x-12 sm:grid-cols-2">
      {FEATURES.map((feature) => (
        <li class="flex gap-4 border-t border-ink-700/60 py-6">
          <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink-800 text-brand-400">
            <Icon name={feature.icon} size={18} />
          </span>
          <div>
            <h3 class="text-[0.98rem] font-semibold">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-300">{feature.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
