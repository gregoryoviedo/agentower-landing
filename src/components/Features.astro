---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { FEATURES } from '../data/site';
---

<section id="caracteristicas" class="relative py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading
      eyebrow="Características"
      title="Pensado para dejar la máquina trabajando"
      description="Ejecutá, monitoreá y guiá sesiones de tus agentes desde el teléfono mientras tu máquina hace el trabajo real."
    />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {FEATURES.map((feature) => (
        <li class="card card-hover flex flex-col p-6">
          <span class="grid h-11 w-11 place-items-center rounded-xl border border-brand-500/25 bg-brand-500/10 text-brand-400">
            <Icon name={feature.icon} size={20} />
          </span>
          <h3 class="mt-5 text-[0.98rem] font-semibold">{feature.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-300">{feature.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
