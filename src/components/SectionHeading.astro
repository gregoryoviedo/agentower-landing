---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'center' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' ? 'mx-auto text-center' : 'text-left']}>
  <span class="eyebrow">{eyebrow}</span>
  <h2 class="mt-3 text-3xl font-bold leading-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-relaxed text-ink-300">{description}</p>}
</div>
