---
import Icon from './Icon.astro';
import { DOWNLOADS, REPO, ALL_RELEASES, VERSION, BASE } from '../data/site';

const base = BASE;

const badges = [
  { label: 'MIT', icon: 'lock' },
  { label: 'Go 1.22+', icon: 'terminal' },
  { label: 'macOS · Windows', icon: 'app' },
  { label: VERSION, icon: 'spark' }
];

interface Message {
  from: 'bot' | 'user';
  body: string;
  title?: string;
  meta?: string;
  options?: string[];
}

const messages: Message[] = [
  {
    from: 'bot',
    title: '✅ Tarea completada',
    body: 'opencode · agentower — refactor del módulo de auth. 4 archivos cambiados.',
    meta: 'hace 2 min'
  },
  {
    from: 'user',
    body: 'usa un middleware en vez de duplicar el check en cada handler'
  },
  {
    from: 'bot',
    title: '❓ El agente pregunta',
    body: '¿Qué estrategia de caché prefieres para las sesiones?',
    meta: 'hace 1 min',
    options: ['En memoria con TTL', 'SQLite en disco', 'Responder con texto…']
  }
];
---

<section id="top" class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="pointer-events-none absolute inset-0 grid-glow" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[42rem] hairline-grid" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
      <div>
        <h1 class="text-4xl font-extrabold leading-[1.05] text-balance sm:text-5xl lg:text-6xl">
          Controlá tus <span class="text-brand-400">agentes de IA</span> desde Telegram
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-300 sm:text-lg">
          Agentower conecta tu teléfono con los agentes que corren en tu máquina:{' '}
          <strong class="font-semibold text-ink-100">opencode, Claude Code, Kiro, GitHub Copilot, Codex y Antigravity</strong>.
          Seguí el progreso, respondé preguntas y retomá sesiones sin exponer ni un puerto a internet.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={DOWNLOADS.macos} class="btn btn-primary" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.4 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.7.8-3.4.8-.7 0-1.8-.8-3-.8-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.7 1.1 8.9.8 1.1 1.7 2.3 2.9 2.2 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.2 0 2-1.1 2.8-2.2.9-1.2 1.2-2.4 1.2-2.5 0 0-2.4-.9-2.5-3.4ZM14.2 5.6c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.2 1.9-1 3 1 .1 2.1-.5 2.8-1.4Z" />
            </svg>
            Descargar para macOS
          </a>
          <a href={DOWNLOADS.windows} class="btn btn-ghost" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 5.5l7.5-1v7H3v-6ZM11.6 4.3 21 3v8.5h-9.4V4.3ZM3 12.5h7.5v7L3 18.5v-6ZM11.6 12.5H21V21l-9.4-1.3v-7.2Z" />
            </svg>
            Descargar para Windows
          </a>
          <a href={REPO} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            <Icon name="github" size={18} />
            Ver el código
          </a>
        </div>

        <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-3">
          {badges.map((badge) => (
            <li class="flex items-center gap-2 text-sm text-ink-400">
              <Icon name={badge.icon} size={16} class="text-brand-400" />
              {badge.label}
            </li>
          ))}
        </ul>

        <p class="mt-6 max-w-xl text-sm leading-relaxed text-ink-400">
          La app se firma ad-hoc (sin Developer ID), así que macOS pide confirmación la primera vez. Todo corre en tu
          máquina con tu propio bot de Telegram.
          <a href={ALL_RELEASES} target="_blank" rel="noopener noreferrer" class="ml-1 text-ink-300 underline decoration-dotted underline-offset-4 hover:text-white">
            Ver todos los releases
          </a>
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-md animate-float">
        <div class="card relative overflow-hidden">
          <div class="flex items-center gap-3 border-b border-ink-700/70 bg-ink-850/80 px-4 py-3">
            <div class="grid h-9 w-9 place-items-center rounded-full bg-brand-500 text-sm font-bold text-ink-950">
              A
            </div>
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold">Agentower Bot</p>
              <p class="flex items-center gap-1.5 text-[0.75rem] text-brand-400">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
                en línea · long polling
              </p>
            </div>
            <span class="ml-auto rounded-md bg-ink-800 px-2 py-1 font-mono text-[0.72rem] text-ink-400">telegram</span>
          </div>

          <div class="space-y-3.5 bg-[#0b1017] px-4 py-5">
            {messages.map((message) => (
              <div class={message.from === 'user' ? 'flex justify-end' : 'flex justify-start'}>
                <div
                  class:list={[
                    'max-w-[85%] rounded-2xl px-3.5 py-2.5 text-[0.82rem] leading-snug',
                    message.from === 'user'
                      ? 'rounded-br-md bg-brand-500 text-ink-950'
                      : 'rounded-bl-md bg-ink-800 text-ink-100'
                  ]}
                >
                  {message.title && <p class="mb-1 font-semibold text-white">{message.title}</p>}
                  <p class={message.from === 'user' ? 'font-medium' : 'text-ink-200'}>{message.body}</p>
                  {message.options && (
                    <div class="mt-2.5 space-y-1.5">
                      {message.options.map((option) => (
                        <div class="flex items-center gap-1.5 text-[0.75rem] font-medium text-brand-400">
                          <span class="text-ink-500">›</span>
                          {option}
                        </div>
                      ))}
                    </div>
                  )}
                  {message.meta && <p class="mt-1.5 text-right text-[0.72rem] text-ink-500">{message.meta}</p>}
                </div>
              </div>
            ))}
          </div>

          <div class="flex items-center gap-2 border-t border-ink-700/70 bg-ink-850/80 px-4 py-3">
            <div class="flex-1 rounded-xl bg-ink-800 px-3 py-2 text-[0.78rem] text-ink-500">
              Responder al agente…
            </div>
            <div class="grid h-8 w-8 place-items-center rounded-full bg-brand-500 text-ink-950">
              <Icon name="arrow" size={16} />
            </div>
          </div>
        </div>

        <div class="absolute -left-4 bottom-16 hidden items-center gap-2 rounded-xl border border-ink-700/70 bg-ink-900 px-3 py-2 text-xs sm:flex">
          <Icon name="shield" size={15} class="text-brand-400" />
          <span class="text-ink-300">Solo tu chat ID</span>
        </div>
        <div class="absolute -right-3 top-24 hidden items-center gap-2 rounded-xl border border-ink-700/70 bg-ink-900 px-3 py-2 text-xs sm:flex">
          <Icon name="radio" size={15} class="text-accent-400" />
          <span class="text-ink-300">0 puertos abiertos</span>
        </div>
      </div>
    </div>
  </div>
</section>
