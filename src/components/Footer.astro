---
import Icon from './Icon.astro';
import { REPO, REPO_LANDING, ALL_RELEASES, SECURITY, LICENSE, DESIGN_DOC, ISSUES, BASE } from '../data/site';

const base = BASE;
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Producto',
    links: [
      { label: 'Agentes soportados', href: '#agentes' },
      { label: 'Características', href: '#caracteristicas' },
      { label: 'Crear el bot de Telegram', href: '#telegram' },
      { label: 'Instalación', href: '#instalacion' },
      { label: 'Descarga', href: '#descarga' }
    ]
  },
  {
    title: 'Recursos',
    links: [
      { label: 'Releases', href: ALL_RELEASES, external: true },
      { label: 'Modelo de seguridad', href: SECURITY, external: true },
      { label: 'Documento de diseño', href: DESIGN_DOC, external: true },
      { label: 'Issues', href: ISSUES, external: true }
    ]
  },
  {
    title: 'Proyecto',
    links: [
      { label: 'Código en GitHub', href: REPO, external: true },
      { label: 'Landing (este sitio)', href: REPO_LANDING, external: true },
      { label: 'Licencia MIT', href: LICENSE, external: true }
    ]
  }
];
---

<footer class="relative border-t border-ink-700/60 py-14">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(3,0.9fr)]">
      <div>
        <a href="#top" class="flex items-center gap-2.5">
          <img
            src={`${base}app-icon.jpeg`}
            alt="Agentower"
            width="38"
            height="38"
            class="h-[38px] w-[38px] rounded-xl ring-1 ring-white/10"
          />
          <span class="text-base font-bold tracking-tight">Agentower</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-400">
          Control remoto desde Telegram para tus agentes de IA locales. Un binario Go y apps nativas opcionales para macOS y Windows.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="rounded-md border border-ink-700/70 bg-ink-850 px-2 py-1 font-mono text-[0.72rem] text-ink-400">MIT</span>
          <span class="rounded-md border border-ink-700/70 bg-ink-850 px-2 py-1 font-mono text-[0.72rem] text-ink-400">Go 1.22+</span>
          <span class="rounded-md border border-ink-700/70 bg-ink-850 px-2 py-1 font-mono text-[0.72rem] text-ink-400">self-hosted</span>
        </div>
      </div>

      {columns.map((column) => (
        <nav aria-label={column.title}>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-500">{column.title}</h3>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-ink-300 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-ink-700/60 pt-6 sm:flex-row">
      <p class="text-xs text-ink-500">
        © {year} Agentower · Hecho por{' '}
        <a href="https://github.com/gregoryoviedo" target="_blank" rel="noopener noreferrer" class="text-ink-400 hover:text-white">gregoryoviedo</a>.
      </p>
      <p class="text-xs text-ink-500">
        No afiliado a Telegram, OpenAI, Anthropic, Google ni GitHub.
      </p>
    </div>
  </div>
</footer>
