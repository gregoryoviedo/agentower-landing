---
import Icon from './Icon.astro';
import { REPO, BASE } from '../data/site';

const base = BASE;

const links = [
  { href: '#agentes', label: 'Agentes' },
  { href: '#caracteristicas', label: 'Características' },
  { href: '#instalacion', label: 'Instalación' },
  { href: '#descarga', label: 'Descarga' },
  { href: '#donar', label: 'Donar' }
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="container-page pt-3 sm:pt-4">
    <nav
      class="flex items-center justify-between gap-4 rounded-2xl border border-ink-700/70 bg-ink-900/75 px-3 py-2.5 backdrop-blur-xl"
      aria-label="Principal"
    >
      <a href="#top" class="flex items-center gap-2.5">
        <img
          src={`${base}app-icon.jpeg`}
          alt="Agentower"
          width="34"
          height="34"
          class="h-[34px] w-[34px] rounded-[0.6rem] ring-1 ring-white/10"
        />
        <span class="text-[0.95rem] font-bold tracking-tight">Agentower</span>
      </a>

      <ul class="hidden items-center gap-1 md:flex">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-ink-300 transition-colors hover:bg-ink-800/70 hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a href={REPO} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-3 py-2.5 sm:px-4" aria-label="Repositorio en GitHub">
          <Icon name="github" size={18} />
          <span class="hidden sm:inline">GitHub</span>
        </a>
        <a href="#descarga" class="btn btn-primary px-3 py-2.5 sm:px-4">
          <Icon name="download" size={18} />
          <span class="hidden sm:inline">Descargar</span>
        </a>

        <button
          type="button"
          id="nav-toggle"
          class="btn btn-ghost px-2.5 py-2.5 md:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="nav-mobile"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </nav>

    <div
      id="nav-mobile"
      class="mt-2 hidden overflow-hidden rounded-2xl border border-ink-700/70 bg-ink-900/95 p-2 backdrop-blur-xl md:hidden"
    >
      <ul class="grid grid-cols-2 gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink-200 transition-colors hover:bg-ink-800/70 hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
