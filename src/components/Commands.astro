---
import SectionHeading from './SectionHeading.astro';
import { COMMANDS } from '../data/site';
---

<section class="relative py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading
      title="Todo se maneja desde el chat"
      description="Escribí comandos en Telegram o usá los botones inline de cada notificación. El texto libre va directo a la sesión activa."
    />

    <div class="card mx-auto mt-12 max-w-3xl overflow-hidden">
      <ul class="divide-y divide-ink-700/50">
        {COMMANDS.map((command) => (
          <li class="grid gap-1.5 px-5 py-4 sm:grid-cols-[minmax(0,13rem)_1fr] sm:items-center sm:gap-6 sm:px-6">
            <code class="font-mono text-[0.82rem] font-medium text-brand-400">{command.cmd}</code>
            <p class="text-sm leading-relaxed text-ink-300">{command.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
