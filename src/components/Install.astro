---
import CodeBlock from './CodeBlock.astro';
import SectionHeading from './SectionHeading.astro';
import { DOWNLOADS, REPO } from '../data/site';

interface Step {
  title: string;
  body: string;
  code?: string;
  label?: string;
}

const macos: Step[] = [
  {
    title: 'Descargá la app',
    body: 'Bajá Agentower.app.zip del último release. Es la build firmada ad-hoc para Apple Silicon (arm64) y requiere macOS 13.0 o superior.'
  },
  {
    title: 'Movela a Aplicaciones',
    body: 'Descomprimí el .zip y copiá el bundle a /Applications con el Finder o desde la terminal.',
    code: 'cp -R Agentower.app /Applications/',
    label: 'macOS'
  },
  {
    title: 'Quitá la marca de Gatekeeper',
    body: 'La app no tiene Developer ID de Apple, así que macOS la bloquea la primera vez. Este comando elimina el atributo de cuarentena.',
    code: 'xattr -dr com.apple.quarantine /Applications/Agentower.app',
    label: 'macOS'
  },
  {
    title: 'Abrí Agentower',
    body: 'Aparece un ícono en la barra de menús. Click izquierdo abre el popover; click derecho, el menú contextual.',
    code: 'open /Applications/Agentower.app',
    label: 'macOS'
  },
  {
    title: 'Cargá tu configuración',
    body: 'En Settings… completá WORKSPACE_ROOT, TELEGRAM_BOT_TOKEN y ALLOWED_CHAT_ID. La sección “Agentes de IA” muestra qué CLIs detectó; habilitá los que quieras y guardá.'
  },
  {
    title: 'Arrancá el bot',
    body: 'Usá el toggle del popover. Si la configuración es válida, la app también arranca el bot sola al abrirla (incluido el inicio de sesión).'
  }
];

const windows: Step[] = [
  {
    title: 'Descargá el ejecutable',
    body: 'Bajá Agentower.exe del último release. Es un binario self-contained para Windows 10/11 x64: no hace falta instalar .NET.'
  },
  {
    title: 'Ejecutalo',
    body: 'Es portable. La primera vez ofrece instalarse: copia el .exe a %LOCALAPPDATA%\\Programs\\Agentower, crea accesos directos y registra el arranque con Windows. Podés forzarlo por CLI.'
  },
  {
    title: 'Abrí la configuración',
    body: 'El ícono aparece en el área de notificación. Click izquierdo abre el popover; click derecho, el menú. Entrá a Configuración….',
    code: 'Agentower.exe --install',
    label: 'Opcional'
  },
  {
    title: 'Completá los datos',
    body: 'Rellená WORKSPACE_ROOT, TELEGRAM_BOT_TOKEN y ALLOWED_CHAT_ID, habilitá los agentes detectados y guardá. El wrapper escribe settings.json y .env en %APPDATA%\\Agentower\\.'
  },
  {
    title: 'Arrancá el bot',
    body: 'Usá el toggle. Con el auto-inicio activo, al encender el equipo la app arranca el bot automáticamente si la configuración es válida.'
  }
];

const cli: Step[] = [
  {
    title: 'Cloná y compilá el binario',
    body: '¿Preferís el binario Go puro, sin la app nativa? Necesitás Go 1.22 o superior.',
    code: `git clone ${REPO}.git\ncd agentower\ngo build -o remote-bot ./cmd/remote-bot`,
    label: 'shell'
  },
  {
    title: 'Creá tu archivo .env',
    body: 'Copiá las tres variables obligatorias en un archivo y completá los valores.',
    code: `WORKSPACE_ROOT=/ruta/a/tu/workspace\nTELEGRAM_BOT_TOKEN=123456:ABC-DEF...\nALLOWED_CHAT_ID=123456789`,
    label: '.env'
  },
  {
    title: 'Ejecutalo',
    body: 'Apuntá ENV_FILE a tu archivo o exportá las variables en el shell. Se detiene con Ctrl+C, y el bot apaga los subprocesos que haya arrancado él.',
    code: 'ENV_FILE=/ruta/a/tu/.env ./remote-bot',
    label: 'shell'
  }
];

const tabs = [
  { id: 'macos', label: 'macOS', steps: macos, href: DOWNLOADS.macos },
  { id: 'windows', label: 'Windows', steps: windows, href: DOWNLOADS.windows },
  { id: 'cli', label: 'Binario Go (avanzado)', steps: cli, href: null }
];
---

<section id="instalacion" class="relative py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading
      eyebrow="Guía paso a paso"
      title="Cómo instalarlo"
      description="Elegí tu plataforma. Cada paso es copiable y no requiere permisos de administrador más allá de mover la app a Aplicaciones."
    />

    <div class="mx-auto mt-12 max-w-3xl">
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Sistema operativo">
        {tabs.map((tab, index) => (
          <button
            type="button"
            data-tab={tab.id}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            class:list={[
              'tab-btn rounded-xl border px-4 py-2.5 text-sm font-medium transition-colors',
              index === 0
                ? 'border-brand-500/50 bg-brand-500/10 text-brand-400'
                : 'border-ink-700/70 bg-ink-850 text-ink-300 hover:text-white'
            ]}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab, index) => (
        <div data-panel={tab.id} class:list={['mt-6', index !== 0 && 'hidden']} role="tabpanel">
          <ol class="space-y-4">
            {tab.steps.map((step, i) => (
              <li class="card p-5 sm:p-6">
                <div class="flex gap-4">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-ink-700/80 bg-ink-850 font-mono text-xs font-semibold text-brand-400">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-[0.98rem] font-semibold">{step.title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-ink-300">{step.body}</p>
                    {step.code && <CodeBlock code={step.code} label={step.label} class="mt-4" />}
                  </div>
                </div>
              </li>
            ))}
          </ol>

          {tab.href && (
            <a href={tab.href} download class="btn btn-primary mt-6 w-full sm:w-auto">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <path d="m7 10 5 5 5-5"></path>
                <path d="M12 15V3"></path>
              </svg>
              Descargar para {tab.label}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

  const activate = (id: string) => {
    tabButtons.forEach((button) => {
      const active = button.dataset.tab === id;
      button.setAttribute('aria-selected', String(active));
      button.classList.toggle('border-brand-500/50', active);
      button.classList.toggle('bg-brand-500/10', active);
      button.classList.toggle('text-brand-400', active);
      button.classList.toggle('border-ink-700/70', !active);
      button.classList.toggle('bg-ink-850', !active);
      button.classList.toggle('text-ink-300', !active);
    });

    panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.panel !== id));
  };

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => activate(button.dataset.tab ?? 'macos'));
  });
</script>
